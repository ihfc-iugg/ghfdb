{#- The Markdown of the quality scheme pages. quality_scheme.py supplies what is used
    here: the schema, the parts, the examples of a part, the functions that write an
    example's inputs, expected values and tests, and the criteria with their examples. -#}

{#- A link to a field's entry in the field reference. -#}
{% macro field_link(code) -%}
{{ "{ref}" }}`{{ code }} <field-{{ code | lower }}>`
{%- endmacro %}

{#- The table of fields: code, published column name and name. -#}
{% macro field_table(codes) -%}
| Field code | Published column name | Name |
|---|---|---|
{%- for code in codes %}
{%- set field = schema.get_field(code) %}
| {{ field_link(code) }} | {{ field.custom.columnName | code }} | {{ field.title | cell }} |
{%- endfor -%}
{% endmacro %}

{#- The table of one part's worked examples. -#}
{% macro example_table(part) -%}
| Example | What it shows | Inputs | Expected | Portal test |
|---|---|---|---|---|
{%- for example in examples_of(part) %}
| {{ example.id | code }} | {{ example.title | cell }} | {{ inputs(example) }} | {{ expected(example) }} | {{ tests(example) }} |
{%- endfor -%}
{% endmacro %}

{#- The table of criteria and the examples that exercise each. -#}
{% macro coverage() -%}
| Criterion | What it covers | Examples |
|---|---|---|
{%- for key, label in criteria.items() %}
{%- set ids = covering(key) %}
| {{ key | code }} | {{ label | cell }} | {{ ids | length }}: {{ ids[:3] | map("code") | join(", ") }}{{ ", …" if ids | length > 3 }} |
{%- endfor -%}
{% endmacro %}
