PREFIX : <https://example.test/vocabularies/colours/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ex: <https://example.test/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ex:colours
    a skos:ConceptScheme ;
    dcterms:isPartOf <https://doi.org/10.0000/test.3> ;
    skos:prefLabel "Colours"@en ;
.

:warm
    a skos:Collection ;
    skos:member :red , :orange ;
    skos:prefLabel "Warm colours"@en ;
.

:red
    a skos:Concept ;
    skos:altLabel "Crimson"@en ;
    skos:hiddenLabel "reddish"@en ;
    skos:inScheme ex:colours ;
    skos:notation "rd" ;
    skos:prefLabel "red"@en ;
    skos:prefLabel "rot"@de ;
.

:orange
    a skos:Concept ;
    skos:inScheme ex:colours ;
    skos:notation "or" ;
    skos:prefLabel "Orange"@en ;
.

:blue
    a skos:Concept ;
    skos:inScheme ex:colours ;
    skos:prefLabel "Blue"@en ;
.

:green
    a skos:Concept ;
    skos:inScheme ex:colours ;
    skos:prefLabel "green"@en ;
.
