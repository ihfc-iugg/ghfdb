<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#">
  <skos:ConceptScheme rdf:about="https://example.test/schemes/rocks">
    <skos:prefLabel xml:lang="en">Rocks</skos:prefLabel>
  </skos:ConceptScheme>
  <skos:Collection rdf:about="https://example.test/rocks/all">
    <skos:member rdf:resource="https://example.test/rocks/igneous"/>
    <skos:member rdf:resource="https://example.test/rocks/sedimentary"/>
  </skos:Collection>
  <skos:Collection rdf:about="https://example.test/rocks/igneous">
    <skos:member rdf:resource="https://example.test/rocks/volcanic_glass"/>
  </skos:Collection>
  <skos:Collection rdf:about="https://example.test/rocks/sedimentary">
    <skos:member rdf:resource="https://example.test/rocks/sandstone"/>
  </skos:Collection>
  <skos:Concept rdf:about="https://example.test/rocks/volcanic_glass">
    <skos:inScheme rdf:resource="https://example.test/schemes/rocks"/>
    <skos:prefLabel xml:lang="en">volcanic glass</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="https://example.test/rocks/sandstone">
    <skos:inScheme rdf:resource="https://example.test/schemes/rocks"/>
    <skos:prefLabel xml:lang="en">sandstone</skos:prefLabel>
  </skos:Concept>
  <skos:Concept rdf:about="https://example.test/rocks/boundary">
    <skos:inScheme rdf:resource="https://example.test/schemes/rocks"/>
    <skos:prefLabel xml:lang="en">boundary</skos:prefLabel>
  </skos:Concept>
</rdf:RDF>
