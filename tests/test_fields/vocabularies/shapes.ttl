PREFIX : <https://example.test/vocabularies/shapes/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX ex: <https://example.test/vocabularies/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

ex:shapes
    a skos:ConceptScheme ;
    dcterms:isPartOf <https://doi.org/10.0000/test.1> ;
    skos:prefLabel "Shapes"@en ;
.

:round
    a skos:Concept ;
    skos:inScheme ex:shapes ;
    skos:prefLabel "Round"@en ;
.
